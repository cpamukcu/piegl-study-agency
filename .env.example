# Copy this file to .env.local and fill it in. Never commit .env.local.

# Where private study data lives: database, course files, extracted text,
# ZJU login session, logs. Must be outside this repository.
DATA_DIR=~/PIEGL-data

# Claude API, used from milestone M4. Leave blank to run with AI turned off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Automatic ZJU sync (npm run sync). Days between syncs; the schedule checks every morning.
SYNC_EVERY_DAYS=3
# "chrome" (default) uses your installed Google Chrome with a dedicated profile; "chromium" uses Playwright's build.
SYNC_BROWSER=chrome
# Graduate-system term code for the current semester. Autumn–winter is 12; set this for spring–summer.
# ZJU_YJSY_XQ=
