# Copy this file to .env.local and fill it in. Never commit .env.local.

# Where private study data lives: database, course files, extracted text,
# ZJU login session, logs. Must be outside this repository.
DATA_DIR=~/PIEGL-data

# Your first name, for the greeting on Today ("Good morning, Can"). Optional.
STUDENT_NAME=

# Claude API for Class Ready Briefs, Professor Mode and research plans. Leave blank to run with AI turned off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a stronger model just for grading Professor Mode answers, for example claude-opus-5-5.
ANTHROPIC_PROFESSOR_MODEL=

# Automatic ZJU sync (npm run sync). Days between syncs; the schedule checks every morning.
SYNC_EVERY_DAYS=3
# "chrome" (default) uses your installed Google Chrome with a dedicated profile; "chromium" uses Playwright's build.
SYNC_BROWSER=chrome
# Download the PDF/PPTX files teachers post on Courses@ZJU during sync (up to 40 per run). Set to 0 to skip.
SYNC_MATERIALS=1
# Graduate-system term code for the current semester. Autumn–winter is 12; set this for spring–summer.
# ZJU_YJSY_XQ=
